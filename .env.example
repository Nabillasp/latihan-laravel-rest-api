APP_NAME=SHOPMATE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Konfigurasi Database Lokal (Default: MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopmate
DB_USERNAME=root
DB_PASSWORD=

# Konfigurasi Database Cloud (Contoh: TiDB Cloud Serverless / MySQL SSL)
# DB_CONNECTION=mysql
# DB_HOST=gateway01.xxx.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_DATABASE=shopmate
# DB_USERNAME=xxx.root
# DB_PASSWORD=your_cloud_password
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# Konfigurasi CORS (Origin Frontend yang Diizinkan)
# Untuk Development Lokal:
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Untuk Production di Render (Isi dengan domain Vercel Anda):
# CORS_ALLOWED_ORIGINS=https://domain-frontend-kamu.vercel.app
